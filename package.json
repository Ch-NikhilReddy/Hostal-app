{
  "name": "hostelmitra",
  "version": "0.1.0",
  "private": true,
  "description": "HostelMitra - Student Hostel / PG booking platform for Hyderabad",
  "license": "UNLICENSED",
  "workspaces": [
    "api",
    "app",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait",
    "db:migrate": "npm run db:migrate --workspace api",
    "db:deploy": "npm run db:deploy --workspace api",
    "db:status": "npm run db:status --workspace api",
    "db:generate": "npm run db:generate --workspace api",
    "db:seed": "npm run db:seed --workspace api",
    "db:backup": "node scripts/db-backup.mjs",
    "db:backups": "node scripts/db-backup.mjs --list",
    "db:verify-backup": "node scripts/db-backup.mjs --verify",
    "db:residue": "node node_modules/tsx/dist/cli.mjs scripts/db-residue.mjs",
    "api": "npm run dev --workspace api",
    "app": "npm run start --workspace app",
    "web": "npm run dev --workspace web",
    "test": "npm run test --workspace api",
    "test:smoke": "node scripts/smoke-test.mjs",
    "verify": "npm run typecheck --workspace api && npm run test --workspace api",
    "typecheck": "npm run typecheck --workspace api && npm run typecheck --workspace app"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "prisma": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true
  }
}