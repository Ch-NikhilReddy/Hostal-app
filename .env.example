# ---- Database (matches docker-compose.yml defaults) ----
POSTGRES_USER=hostelmitra
POSTGRES_PASSWORD=hostelmitra
POSTGRES_DB=hostelmitra
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hostelmitra:hostelmitra@localhost:5432/hostelmitra?schema=public

# ---- API ----
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# Auth: CHANGE THIS to a long random string before any deployment.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Commission default (percent). Overridable per booking / per owner.
DEFAULT_COMMISSION_PERCENT=10

# ---- CORS ----
# REQUIRED in production. Comma-separated list of exact frontend origins.
#   https://app.hostelmitra.com,https://admin.hostelmitra.com
#
# The API refuses to start in production if this is missing or set to "*".
# Loopback origins (localhost / 127.0.0.1) are allowed automatically in
# development only. The React Native app sends no Origin header and is
# unaffected by this setting.
CORS_ORIGINS=http://localhost:5173

# Integrations: leave blank to use the built-in free dev stubs ----

# Razorpay. Use rzp_test_* keys for local development (free, test money).
# If both are blank the API uses its internal MockGateway, which simulates the
# full payment lifecycle so booking flows are testable with zero setup.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS / OTP delivery. Blank -> OTP is printed to the API console and returned in
# the dev response body only (NODE_ENV=development). Production refuses to boot
# without a real provider or an explicit OTP_PROVIDER=console opt-in.
OTP_PROVIDER=console
MSG91_AUTH_KEY=
MSG91_SENDER_ID=HMTRIA

# Echo the login code back in the API response, for local development only.
# Leave this UNSET (the default) unless you are running the app on your own
# machine with no SMS provider. With it unset you read the code from the API
# console output instead.
#
# When it is on, anyone who can reach this API can sign in as any user, so the
# server refuses to start if this is true and NODE_ENV=production.
ENABLE_DEV_OTP=

# Firebase Cloud Messaging (free tier: unlimited push). Blank -> notifications are
# persisted to the DB only and readable via GET /v1/notifications.
FCM_SERVER_KEY=

# Object storage for hostel photos. Blank -> files are written to ./var/uploads
# and served from /uploads by the API itself.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=